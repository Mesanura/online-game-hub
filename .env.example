# Docker Compose single-host deployment. Copy this file to .env and replace
# every replace-* value before exposing the deployment beyond local loopback.
COMPOSE_PROJECT_NAME=online-game-hub
HOST_BIND_ADDRESS=127.0.0.1

POSTGRES_DB=online_game_hub
POSTGRES_USER=online_game_hub
# Keep this URL-safe because Compose also uses it in PostgreSQL connection URLs.
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_PORT=5432
POSTGRES_INTERNAL_PORT=5432
POSTGRES_VOLUME_NAME=online-game-hub-postgres-data

WEB_PORT=3000
WEB_INTERNAL_PORT=3000
GAME_SERVER_PORT=2567
GAME_SERVER_INTERNAL_PORT=2567

# These are browser-facing addresses, not Docker service hostnames. If a host
# port or hostname changes, update both values and the allowed Web origin.
WEB_PUBLIC_ORIGIN=http://localhost:3000
GAME_SERVER_PUBLIC_URL=http://localhost:2567

# Local loopback HTTP acceptance uses development policy with production-built
# images. A public HTTPS deployment must set APP_ENV=production, use https://
# public addresses, and set GUEST_COOKIE_SECURE=true.
APP_ENV=development
GUEST_COOKIE_SECURE=false

# Replace these with two different, random values of at least 32 bytes.
GUEST_SESSION_SECRET=replace-with-an-independent-guest-secret-at-least-32-bytes
GAME_SERVER_TICKET_SECRET=replace-with-a-shared-ticket-secret-at-least-32-bytes
GAME_SERVER_TICKET_ISSUER=online-game-hub-web
GAME_SERVER_TICKET_LIFETIME_SECONDS=30
GAME_SERVER_RECONNECT_GRACE_MILLISECONDS=60000
