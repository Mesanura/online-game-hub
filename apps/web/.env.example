# Next.js loads this file only after you copy it to an ignored .env.local.
APP_ENV=development
DATABASE_MODE=postgres
DATABASE_URL=postgresql://online_game_hub:replace-me@127.0.0.1:5432/online_game_hub
GAME_SERVER_PUBLIC_URL=http://127.0.0.1:2567

# Replace both placeholders with independent random values of at least 32 bytes.
GUEST_SESSION_SECRET=replace-with-an-independent-random-secret
GAME_SERVER_TICKET_SECRET=replace-with-the-game-server-shared-ticket-secret
GAME_SERVER_TICKET_ISSUER=online-game-hub-web
GAME_SERVER_TICKET_LIFETIME_SECONDS=30

# Local HTTP development only. Production configuration rejects false.
GUEST_COOKIE_SECURE=false
