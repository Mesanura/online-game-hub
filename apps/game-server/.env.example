APP_ENV=development
DATABASE_MODE=postgres
DATABASE_URL=postgresql://online_game_hub:replace-me@127.0.0.1:5432/online_game_hub
GAME_SERVER_HOST=127.0.0.1
GAME_SERVER_PORT=2567
GAME_SERVER_ALLOWED_WEB_ORIGINS=http://127.0.0.1:3000
GAME_SERVER_RECONNECT_GRACE_MILLISECONDS=60000

# Must exactly match the Web issuer and ticket secret.
GAME_SERVER_TICKET_ISSUER=online-game-hub-web
GAME_SERVER_TICKET_SECRET=replace-with-the-web-shared-ticket-secret
